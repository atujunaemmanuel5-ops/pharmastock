# Optional PostgreSQL connection. The local API works without it.
ENVIRONMENT=development
PHARMASTOCK_AUTH_REQUIRED=false
PHARMASTOCK_API_KEY=replace-with-a-long-random-api-key
PHARMASTOCK_ADMIN_KEY=replace-with-a-different-long-random-admin-key
PHARMASTOCK_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pharmastock
PHARMASTOCK_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
VITE_API_KEY=
VITE_ADMIN_KEY=
PHARMASTOCK_MAX_UPLOAD_BYTES=5242880
PHARMASTOCK_MAX_UPLOAD_ROWS=100000
